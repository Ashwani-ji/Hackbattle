# Copy this file to ".env" in the backend/ folder and fill in your key.
# Without a key, /api/refactor falls back to an offline mock so the app
# still runs end-to-end (Panic Mode + Arcade Mode both work).

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
